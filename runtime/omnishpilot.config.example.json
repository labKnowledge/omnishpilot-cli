{
  "port": 4580,
  "host": "127.0.0.1",
  "dataDir": "./data",
  "omnish": {
    "enabled": true,
    "peer": "*",
    "bin": "omnish"
  },
  "worker": {
    "pollIntervalMs": 5000,
    "maxConcurrent": 1,
    "supervisorIntervalMs": 300000,
    "retryBackoffSec": 120,
    "heartbeatIntervalMinutes": 10
  },
  "scheduler": {
    "defaultTimezone": "America/Denver",
    "minIntervalMinutes": 5
  },
  "suggestions": {
    "halfLifeDays": 14,
    "minCount": 2,
    "macroWindowMinutes": 120,
    "macroMinCount": 3,
    "macroMinDays": 2
  },
  "auth": {
    "enabled": true,
    "password": "change-me"
  },
  "agent": {
    "cursorAgent": "cursor-agent",
    "cursorModel": "",
    "defaultWorkspace": "",
    "envFile": "",
    "preferredOrder": ["cursor-agent", "claude", "agy"],
    "cooldownMinutes": 60
  },
  "sandbox": {
    "enabled": true,
    "backend": "auto",
    "network": true,
    "requireForAutonomous": true,
    "hidePaths": ["~/.ssh", "~/.aws", "~/.gnupg", "~/.kube", "~/.docker"],
    "extraBindRw": []
  },
  "workspaces": []
}
