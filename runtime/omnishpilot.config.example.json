{
  "port": 4580,
  "host": "127.0.0.1",
  "dataDir": "./data",
  "omnish": {
    "enabled": true,
    "peer": "*",
    "bin": "omnish"
  },
  "worker": {
    "pollIntervalMs": 5000,
    "maxConcurrent": 1,
    "supervisorIntervalMs": 300000,
    "retryBackoffSec": 120,
    "heartbeatIntervalMinutes": 10,
    "hangIdleMinutes": 12,
    "hangHardMinutes": 45,
    "hangCheckIntervalMs": 30000,
    "jobTimeoutMinutes": 240,
    "keepAwake": true,
    "keepAwakeMinutes": 15
  },
  "budget": {
    "dailyAgentMinutes": 0,
    "monthlyUsd": 0,
    "warnAtPercent": 80
  },
  "scheduler": {
    "defaultTimezone": "America/Denver",
    "minIntervalMinutes": 5
  },
  "suggestions": {
    "halfLifeDays": 14,
    "minCount": 2,
    "macroWindowMinutes": 120,
    "macroMinCount": 3,
    "macroMinDays": 2
  },
  "auth": {
    "enabled": true,
    "password": "change-me"
  },
  "agent": {
    "agentRunBin": "agent-run",
    "cursorAgent": "cursor-agent",
    "cursorModel": "",
    "defaultWorkspace": "",
    "envFile": "",
    "preferredOrder": ["cursor-agent", "claude", "agy"],
    "cooldownMinutes": 60,
    "devMode": "auto",
    "attachDevSkill": false,
    "defaultSkills": []
  },
  "sandbox": {
    "enabled": true,
    "backend": "auto",
    "network": true,
    "requireForAutonomous": true,
    "hidePaths": ["~/.ssh", "~/.aws", "~/.gnupg", "~/.kube", "~/.docker"],
    "extraBindRw": []
  },
  "acceptance": {
    "enabled": true,
    "always": false,
    "defaultArtifacts": ["result.md"],
    "defaultTestCommand": null,
    "verifier": false,
    "soft": false,
    "testTimeoutSec": 300,
    "verifierTimeoutSec": 600
  },
  "worktree": {
    "enabled": true,
    "root": "",
    "baseRef": "HEAD",
    "keepOnSuccess": false,
    "keepOnFailure": true
  },
  "webhooks": {
    "enabled": true,
    "token": "",
    "defaultTemplateId": "agent-task",
    "defaultWorkspace": "",
    "defaultRunMode": "auto",
    "defaultAcceptance": "Write result.md summarizing what you did. Verify your work.",
    "verifier": false
  },
  "delivery": {
    "morningPack": true
  },
  "workspaces": []
}
